{
  "expo": {
    "name": "Pidro",
    "slug": "pidro-mobile",
    "version": "3.2.1",
    "scheme": "pidro-mobile",
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      ["expo-localization", { "supportedLocales": ["en", "sv"] }],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your Pidro profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#07264c",
          "android": {
            "image": "./assets/splash-android.png",
            "imageWidth": 288
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "locales": {
      "en": "./locales/en.json",
      "sv": "./locales/sv.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oneapps.pidro",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.oneapps.pidro",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#07264c"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a3690071-f253-4f27-ba73-3120f0b17fed"
      }
    },
    "owner": "marcelfahle",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a3690071-f253-4f27-ba73-3120f0b17fed"
    }
  }
}
