{
  "name": "pidro-mobile",
  "version": "3.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "sync:cards": "node scripts/sync-card-assets.mjs",
    "prestart": "node scripts/sync-card-assets.mjs",
    "preweb": "node scripts/sync-card-assets.mjs",
    "postinstall": "bun --cwd ../shared build",
    "android": "NODE_OPTIONS=\"$NODE_OPTIONS --dns-result-order=ipv4first --require ./scripts/tailwind-v3-resolve.cjs\" EXPO_NO_REDIRECT_PAGE=1 expo start --go --android",
    "ios": "NODE_OPTIONS=\"$NODE_OPTIONS --dns-result-order=ipv4first --require ./scripts/tailwind-v3-resolve.cjs\" EXPO_NO_REDIRECT_PAGE=1 expo start --go --ios",
    "ios:device": "APP_VARIANT=development EXPO_PUBLIC_API_URL=https://app.pidro.online EXPO_PUBLIC_WS_URL=wss://app.pidro.online/socket expo prebuild --clean --platform ios && APP_VARIANT=development EXPO_PUBLIC_API_URL=https://app.pidro.online EXPO_PUBLIC_WS_URL=wss://app.pidro.online/socket NODE_OPTIONS=\"--require $PWD/scripts/tailwind-v3-resolve.cjs\" expo run:ios --no-bundler --device",
    "ios:preview": "APP_VARIANT=preview EXPO_PUBLIC_API_URL=https://app.pidro.online EXPO_PUBLIC_WS_URL=wss://app.pidro.online/socket expo prebuild --clean --platform ios && APP_VARIANT=preview EXPO_PUBLIC_API_URL=https://app.pidro.online EXPO_PUBLIC_WS_URL=wss://app.pidro.online/socket NODE_OPTIONS=\"--require $PWD/scripts/tailwind-v3-resolve.cjs\" expo run:ios --configuration Release --no-bundler --device",
    "start": "NODE_OPTIONS=\"$NODE_OPTIONS --dns-result-order=ipv4first --require ./scripts/tailwind-v3-resolve.cjs\" EXPO_NO_REDIRECT_PAGE=1 expo start --go",
    "start:prod": "EXPO_PUBLIC_API_URL=https://app.pidro.online EXPO_PUBLIC_WS_URL=wss://app.pidro.online/socket NODE_OPTIONS=\"$NODE_OPTIONS --dns-result-order=ipv4first --require ./scripts/tailwind-v3-resolve.cjs\" EXPO_NO_REDIRECT_PAGE=1 expo start --go",
    "start:device": "APP_VARIANT=development EXPO_PUBLIC_API_URL=https://app.pidro.online EXPO_PUBLIC_WS_URL=wss://app.pidro.online/socket NODE_OPTIONS=\"--require ./scripts/tailwind-v3-resolve.cjs\" expo start --dev-client",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "test:smoke": "node scripts/smoke-create-game.mjs",
    "test:ui": "node scripts/verify-ui-grammar.mjs",
    "test:ui:diff": "node scripts/compare-ui-baselines.mjs",
    "test:e2e": "node scripts/ci-game-e2e.mjs",
    "e2e:accounts": "playwright test -c e2e/playwright.config.ts --grep-invert @second-run",
    "e2e:accounts:second-run": "E2E_RUN=-second-run playwright test -c e2e/playwright.config.ts --project phone --grep @second-run",
    "ui:baselines": "node scripts/update-ui-baselines.mjs",
    "ship:ota": "node scripts/ship.mjs ota --wait",
    "ship:build": "node scripts/ship.mjs build --wait",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "NODE_OPTIONS=\"--require ./scripts/tailwind-v3-resolve.cjs\" expo start --web",
    "web:export": "EXPO_NO_DOTENV=1 APP_VARIANT=beta EXPO_PUBLIC_API_URL=https://app.pidro.online EXPO_PUBLIC_WS_URL=wss://app.pidro.online/socket NODE_OPTIONS=\"--require ./scripts/tailwind-v3-resolve.cjs\" expo export --platform web --output-dir dist --clear && cp dist/+not-found.html dist/404.html",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@pidro/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~56.0.24",
    "expo-apple-authentication": "~56.0.4",
    "expo-application": "~56.0.3",
    "expo-audio": "~56.0.13",
    "expo-blur": "~56.0.4",
    "expo-clipboard": "~56.0.4",
    "expo-crypto": "~56.0.5",
    "expo-dev-client": "~56.0.28",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image-manipulator": "~56.0.4",
    "expo-image-picker": "~56.0.5",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.19",
    "expo-localization": "~56.0.6",
    "expo-network": "~56.0.5",
    "expo-router": "~56.2.22",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.16",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.28",
    "expo-web-browser": "~56.0.6",
    "i18n-js": "^4.5.3",
    "nativewind": "^4.2.2",
    "phoenix": "^1.8.4",
    "posthog-react-native": "^4.75.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-qrcode-svg": "^6.3.22",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/eslint-plugin-query": "^5.91.4",
    "@types/phoenix": "^1.6.7",
    "@types/react": "~19.2.14",
    "eslint": "^9.39.3",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "yoga-layout": "^3.2.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "private": true
}
